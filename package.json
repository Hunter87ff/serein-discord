{
    "name": "serein-discord",
    "description": "Feature rich discord music bot built with discord.js",
    "version": "0.0.1",
    "module": "index.ts",
    "type": "module",
    "imports": {
        "#/*": "./src/*"
    },
    "scripts": {
        "dev": "bun index.ts",
        "start": "node dist/index.js",
        "build": "bun build index.ts --outfile dist/index.js --target node"
    },
    "dependencies": {
        "discord.js": "^14.27.0",
        "dotenv": "^17.4.2",
        "lavalink-client": "^2.11.0",
        "mongoose": "^9.10.0"
    },
    "devDependencies": {
        "@types/node": "latest"
    },
    "peerDependencies": {
        "typescript": "^7"
    },
    "engines": {
        "bun": ">=1.1.27",
        "node": ">=22.0.0"
    },
    "packageManager": "bun@1.4.2",
    "pnpm": {
        "onlyBuiltDependencies": [
            "esbuild"
        ]
    }
}